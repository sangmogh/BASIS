    rdfs:label "CX-011 E21 서포트 두께 상향 — 호선마다 다르게: 만든 호선은 기존품 보강, 미제작 호선은 긴급 조달"@ko ;
    bo:PastCase.case "CX-011" ;
    bo:PastCase.title "E21 서포트 두께 상향 — 호선마다 다르게: 만든 호선은 기존품 보강, 미제작 호선은 긴급 조달" ;
    bo:PastCase.partKind bc:part_kind.pipe_support ;
    bo:PastCase.workType bc:work_type.piping ;
