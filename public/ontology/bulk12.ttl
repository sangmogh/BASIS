<case_record/DC-014> a bo:PastCase ;
    rdfs:label "DC-014 E21 화물배관 서포트 보강판 추가"@ko ;
    bo:PastCase.case "DC-014" ;
    bo:PastCase.title "E21 화물배관 서포트 보강판 추가" ;
    bo:PastCase.partKind bc:part_kind.pipe_support ;
    bo:PastCase.workType bc:work_type.piping ;
    bo:PastCase.changeTypes bc:change_type.dimension ;
    bo:PastCase.zoneKind bc:zone_kind.cargo_piping ;
    bo:PastCase.reason bc:reason.internal_error ;
    bo:PastCase.timing bc:timing.block_complete ;
    bo:PastCase.sourceHullText "H-101" ;
    bo:PastCase.originalText "화물창 배관 (E)의 배관 서포트 관련 변경 기록입니다. 대상 공종은 배관이며 변경 유형은 두께·치수 변경입니다. 내부 오류으로 블록 완성에 검토가 시작되어 재작업 방식으로 처리했습니다. 후속 검토 시 당시 조달·작업 상태와 승인 조건을 재확인해야 합니다." ;
    bo:PastCase.specBefore "서포트 보강판 미적용" ;
    bo:PastCase.specAfter "서포트 보강판 추가" ;
    bo:PastCase.maxLocalDelayDays 5 ;
    bo:PastCase.problem "화물창 배관 (E) 블록 완성 조건에서 재작업 처리의 일정·검사 선후관계 검토가 필요했다는 합성 기록." ;
    bo:PastCase.lesson "보강판 용접 뒤 재검사 일정을 미리 잡아 둘 것" ;
    bo:PastCase.occurredAt "2026-08-01T09:00:00Z"^^xsd:dateTime ;
    bo:sourceSystem bc:source_system.CASE ;
    bo:certainty bc:certainty.confirmed ;
    bo:knownAt "2026-08-31T09:00:00Z"^^xsd:dateTime ;
    bo:synthetic true .
