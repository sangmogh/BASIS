# BASIS 온톨로지 · 개념 층 (TBox)
# https://basis.local/onto
# db/schema.sql에서 자동 생성 (npm run onto:build). 손으로 고치지 마세요.

@prefix bo: <https://basis.local/onto#> .
@prefix bc: <https://basis.local/code#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://basis.local/onto> a owl:Ontology ;
    rdfs:label "BASIS 시리즈 호선 설계변경 온톨로지"@ko ;
    rdfs:comment "데이터 계약(db/schema.sql)에서 자동 생성. 표는 개념, 외래키는 관계, 코드값은 SKOS 용어 체계가 된다. 한글 이름 · 연결 관계 · 부재 계층(초안)은 scripts/ontology/curated.ts에서 다듬는다."@ko ;
    owl:versionInfo "schema.sql sha256:d83114e747dc" ;
    dct:source "db/schema.sql" .
bo:table a owl:AnnotationProperty ;
    rdfs:label "DB 표"@ko .
bo:column a owl:AnnotationProperty ;
    rdfs:label "DB 열"@ko .
bo:section a owl:AnnotationProperty ;
    rdfs:label "데이터 묶음"@ko .
bo:group a owl:AnnotationProperty ;
    rdfs:label "주제 묶음"@ko .
bo:sourceSystems a owl:AnnotationProperty ;
    rdfs:label "들어오는 시스템"@ko .
bo:codeScheme a owl:AnnotationProperty ;
    rdfs:label "용어 체계"@ko .
bo:derivedFrom a owl:AnnotationProperty ;
    rdfs:label "만든 근거 개념"@ko .
bo:draft a owl:AnnotationProperty ;
    rdfs:label "초안"@ko .
bo:SourcedRecord a owl:Class ;
    rdfs:label "출처가 붙은 사실"@ko ;
    rdfs:comment "모든 시스템 입력 행: 출처 시스템 · 확실성(확정/잠정/사례/가정) · 알게 된 시각 · 합성 여부가 붙는다"@ko .
bo:SeriesCommon a owl:Class ;
    rdfs:label "시리즈 공통"@ko ;
    rdfs:comment "시리즈의 모든 호선이 함께 쓰는 정보 (도면 · 부품 · 자재 · 견적 · 설계안). 한 번만 조사한다"@ko .
bo:PerHull a owl:Class ;
    rdfs:label "호선마다 다름"@ko ;
    rdfs:comment "호선마다 다른 상태 · 일정 · 위치. 호선별 차이만 본다. 호선 표까지 NOT NULL 외래키로 이어지는 개념"@ko ;
    owl:disjointWith bo:SeriesCommon .
bo:sourceSystem a owl:ObjectProperty ;
    a owl:FunctionalProperty ;
    rdfs:label "출처 시스템"@ko ;
    rdfs:domain bo:SourcedRecord ;
    rdfs:range skos:Concept ;
    bo:codeScheme bc:scheme.source_system ;
    bo:column "source_system" .
