# AI 인증 정보. 이 파일을 .env로 복사해 값을 넣는다 (.env는 커밋되지 않음, 이 파일에는 값을 넣지 않는다)
# Vercel에서는 프로젝트 Settings > Environment Variables에 같은 이름으로 넣는다. 여러 개를 넣으면 Gemini를 먼저 쓴다

# Google Gemini (AIza 로 시작하는 키)
GEMINI_API_KEY=
# 모델을 바꿀 때만 (기본 gemini-3.8-flash)
# GEMINI_MODEL=

# Claude: 학교 BAZE API 게이트웨이를 쓸 때
# ANTHROPIC_BASE_URL=https://api.baze.co/v1/gateway/claude
# ANTHROPIC_AUTH_TOKEN=
# Claude 모델을 바꿀 때만 (기본 claude-opus-5-5). 크레딧을 아끼려면 claude-haiku-5-5
# CLAUDE_MODEL=

# Claude: Anthropic API를 직접 쓸 때 (sk-ant- 로 시작하는 키)
# ANTHROPIC_API_KEY=

# 연동 수신함 (/api/events). 로컬 개발 서버는 둘 다 없어도 메모리로 동작한다
# PLM · ERP · MES가 이벤트를 보낼 때 x-basis-token 헤더에 넣는 값 (Vercel에서는 필수)
BASIS_EVENTS_TOKEN=
# Vercel에서 저장소: 프로젝트 Storage에서 Upstash Redis(KV)를 연결하면 아래 두 값이 자동으로 들어간다
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
